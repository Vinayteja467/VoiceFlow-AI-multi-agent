# ---- Server ----
PORT=8787

# ---- Lyzr (orchestrator + 3 agents) ----
LYZR_API_KEY=
LYZR_ORCHESTRATOR_AGENT_ID=
LYZR_RESEARCH_AGENT_ID=
LYZR_PLANNING_AGENT_ID=
LYZR_TASK_AGENT_ID=

# ---- Qdrant ----
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=voiceflow_memory

# ---- Embeddings ----
# openai | local (local = deterministic hashing embedder, no key needed)
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_DIM=256

# ---- Omi ----
# Optional shared secret: Omi webhook requests must send header `x-omi-secret: <value>`
OMI_WEBHOOK_SECRET=

# ---- Demo mode ----
# Auto-enabled when LYZR_API_KEY or QDRANT_URL are missing. Set explicitly to force.
DEMO_MODE=true
